<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.dimentia.memoir">

    <!-- ─── Permissions ──────────────────────────────────────────────────────
         Order: network → notifications → alarms → boot → hardware → sensors
    ──────────────────────────────────────────────────────────────────────── -->

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Notifications (Android 13+ / API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Exact alarms — required for SCHEDULE_EXACT_ALARM on Android 12+.
         We currently use inexactAllowWhileIdle so this is optional, but
         keeping it here allows the OS to grant exact alarms on devices
         where the user approves it, improving timing accuracy. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Reschedule notifications after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Foreground service (needed if you ever run a background service) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- ✅ REMOVED: USE_FULL_SCREEN_INTENT
         This permission is restricted on Android 14+ (API 34+). Apps that
         are not alarm/calling apps are blocked from using it, causing a
         runtime crash or silent failure in release builds.
         We removed fullScreenIntent from notification_service.dart as well. -->

    <!-- Wake lock — keeps CPU alive while notification fires -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Vibration -->
    <uses-permission android:name="android.permission.VIBRATE" />
    
    <!-- Microphone (speech-to-text / voice features) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <!-- Location (if used for nearby features) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Phone calls -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- ─── Application ──────────────────────────────────────────────────────
         android:allowBackup is explicitly set to false for privacy.
         android:usesCleartextTraffic kept — remove when all traffic is HTTPS.
    ──────────────────────────────────────────────────────────────────────── -->

    <application
        android:name="${applicationName}"
        android:label="Memoir"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">

        <!-- ✅ Firebase default notification channel.
             Must match the channel ID used in NotificationService
             ('reminder_channel'). Without this, Firebase Cloud Messaging
             creates its own channel and conflicts with local notifications. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="reminder_channel" />

        <!-- Flutter embedding version -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- ── Main Flutter Activity ───────────────────────────────────── -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            tools:replace="android:configChanges">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── Emergency lock-screen Activity ────────────────────────────
             showOnLockScreen + turnScreenOn let this appear above the
             lock screen without requiring the deprecated
             FLAG_SHOW_WHEN_LOCKED window flag.
        ──────────────────────────────────────────────────────────────── -->
        <activity
            android:name=".EmergencyActivity"
            android:exported="false"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.NoActionBar"
            android:launchMode="singleTop" />

        <!-- ── Emergency background Service ──────────────────────────── -->
        <service
            android:name=".EmergencyService"
            android:exported="false" />

        <!-- ── Home-screen Widget provider ───────────────────────────── -->
        <receiver
            android:name=".EmergencyWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/emergency_widget_info" />
        </receiver>

        <!-- ── Widget tap receiver ───────────────────────────────────── -->
        <receiver
            android:name=".EmergencyWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.dimentia.memoir.EMERGENCY_TAP" />
            </intent-filter>
        </receiver>

        <!-- ── flutter_local_notifications: fires scheduled alarms ──────
             exported="false" is correct — only the OS alarm manager calls
             this receiver, so it must NOT be accessible from other apps.
        ──────────────────────────────────────────────────────────────── -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false" />

        <!-- ── flutter_local_notifications: reschedules after reboot ────
             Listens for BOOT_COMPLETED and related events so notifications
             survive a device restart. Requires RECEIVE_BOOT_COMPLETED.
        ──────────────────────────────────────────────────────────────── -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>

    <!-- ─── Queries (package visibility — Android 11+) ──────────────────────
         Declare every external intent your app fires so the OS lets you
         resolve the target package on Android 11+ (API 30+).
    ──────────────────────────────────────────────────────────────────────── -->

    <queries>
        <!-- Text processing (copy/paste context menu) -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>

        <!-- Phone dialler -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>

        <!-- Direct call (requires CALL_PHONE permission above) -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tel" />
        </intent>

        <!-- Open HTTPS URLs in browser -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>

        <!-- SMS -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
    </queries>

</manifest>