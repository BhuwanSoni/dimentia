<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#FF0D0D0D">

    <!-- 🚨 Icon -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚨"
        android:textSize="72sp"
        android:layout_marginBottom="16dp" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Emergency Alert"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- ✅ Subtitle — updated dynamically in Kotlin (not auto-calling) -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ready to call your caregiver"
        android:textColor="#BBBBBB"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="28dp" />

    <!-- ✅ Phone number — populated from Flutter MethodChannel -->
    <TextView
        android:id="@+id/tvPhoneNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📞 Loading..."
        android:textColor="#4CAF50"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="48dp" />

    <!-- CALL button -->
    <Button
        android:id="@+id/callButton"
        android:layout_width="260dp"
        android:layout_height="64dp"
        android:text="📞  CALL NOW"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#D32F2F"
        android:layout_marginBottom="16dp"
        android:elevation="6dp" />

    <!-- Cancel button -->
    <Button
        android:id="@+id/cancelButton"
        android:layout_width="260dp"
        android:layout_height="52dp"
        android:text="Cancel"
        android:textColor="#BBBBBB"
        android:textSize="15sp"
        android:backgroundTint="#2A2A2A"
        android:elevation="2dp" />

</LinearLayout>